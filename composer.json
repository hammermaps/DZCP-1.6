{
  "name": "dzcp/core",
  "description": "DZCP-CMS Full Install",
  "minimum-stability": "dev",
  "license": "MIT",
  "authors": [
    {
      "name": "DZCP.de Team",
      "email": "info@dzcp.de"
    }
  ],
  "optimize-autoloader": true,
  "require": {
    "php": ">=8.4",
    "ext-mbstring": "*",
    "ext-json": "*",
    "ext-intl": "*",
    "ext-bcmath": "*",
    "ext-iconv": "*",
    "ext-mysqli": "*",
    "monolog/monolog": "^3.10.0",
    "phpfastcache/phpfastcache": "8.0.8.0",
    "phpmailer/phpmailer": "^7.0.2",
    "jaybizzle/crawler-detect": "^1.3.7",
    "wixel/gump": "2.3.2",
    "ext-zlib": "*"
  },
  "autoload": {
    "classmap": [
      "inc/debugger.php",
      "inc/dbc.php",
      "inc/api.php",
      "inc/steamapi.php",
      "inc/cookie.php"
    ]
  }
}
