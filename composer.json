{
  "name": "dzcp/core",
  "description": "DZCP-CMS Full Install",
  "minimum-stability": "dev",
  "license": "MIT",
  "authors": [
    {
      "name": "DZCP.de Team",
      "email": "info@dzcp.de"
    }
  ],
  "config": {
    "optimize-autoloader": true
  },
  "require": {
    "php": ">=8.4",
    "ext-mbstring": "*",
    "ext-json": "*",
    "ext-intl": "*",
    "ext-bcmath": "*",
    "ext-iconv": "*",
    "ext-mysqli": "*",
    "monolog/monolog": "^3.10.0",
    "phpfastcache/phpfastcache": "9.2.4",
    "phpmailer/phpmailer": "^7.0.2",
    "jaybizzle/crawler-detect": "^1.3.7",
    "wixel/gump": "2.3.2",
    "ext-zlib": "*",
    "tracy/tracy": "^2.10",
    "austinb/gameq": "~3.1"
  },
  "autoload": {
    "classmap": [
      "inc/debugger.php",
      "inc/dbc.php",
      "inc/api.php",
      "inc/steamapi.php",
      "inc/cookie.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "DZCP\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "phpunit/phpunit": "^11.5"
  }
}
